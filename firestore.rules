rules_version = '2';

// Egg App security rules.
// There are no passwords: the app signs in anonymously in the background, so only
// requests coming from the app itself are answered. The data checks below stop
// anything that isn't a well-formed egg entry from being saved.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validEntry(d) {
      return d.keys().hasAll(['type', 'eggs', 'user', 'date', 'createdAt'])
        && d.keys().hasOnly(['type', 'eggs', 'price', 'user', 'date', 'createdAt', 'updatedAt', 'adjust'])
        && d.type in ['collected', 'sold', 'farm']
        && d.eggs is int && d.eggs >= -9999 && d.eggs <= 9999
        && d.user in ['Nate', 'Ruth']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.createdAt is timestamp
        && (!('adjust' in d) || d.adjust is bool)
        && (d.type == 'sold'
              ? (d.price is number && d.price > 0 && d.price < 100)
              : !('price' in d));
    }

    // One document per button tap (or correction)
    match /entries/{entryId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(request.resource.data);
      allow delete: if signedIn();
    }

    // Expenses: one document per expense (amount in cents)
    match /expenses/{expenseId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validExpense(request.resource.data);
      allow delete: if signedIn();
    }

    function validExpense(d) {
      return d.keys().hasAll(['date', 'cents', 'user', 'createdAt'])
        && d.keys().hasOnly(['date', 'cents', 'note', 'user', 'createdAt', 'updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.cents is int && d.cents > 0 && d.cents < 10000000
        && d.user in ['Nate', 'Ruth']
        && (!('note' in d) || (d.note is string && d.note.size() <= 500))
        && d.createdAt is timestamp;
    }

    // Shared settings: the price list and the flock (start date + size history)
    match /settings/main {
      allow read: if signedIn();
      allow write: if signedIn() && validSettings(request.resource.data);
    }

    function validSettings(d) {
      return d.keys().hasOnly(['prices', 'flockStart', 'flockLog', 'updatedAt'])
        && (!('prices' in d) || (d.prices is list && d.prices.size() <= 20))
        && (!('flockStart' in d) || (d.flockStart is string && d.flockStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('flockLog' in d) || (d.flockLog is list && d.flockLog.size() <= 500));
    }
  }
}
